# ── Runtime ────────────────────────────────────────────────────────────────────
NODE_ENV=production

# ── Telegram ───────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_ADMIN_ID=your_telegram_user_id_here   # numeric user ID (not username)

# ── Database (same PostgreSQL as Replit dashboard) ─────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── App session ────────────────────────────────────────────────────────────────
SESSION_SECRET=any_random_long_string_here

# ── Binance Futures API ────────────────────────────────────────────────────────
BINANCE_API_KEY=your_binance_api_key
BINANCE_API_SECRET=your_binance_api_secret

# ── Live trading ───────────────────────────────────────────────────────────────
# Set to "true" ONLY when you are ready to trade real money.
# Leave as "false" to run in paper-only mode (bot tracks signals, no real orders).
LIVE_TRADING=false

TRADE_RISK_PCT=2       # % of free USDT balance to risk per trade  (e.g. 2 = 2%)
TRADE_LEVERAGE=10      # Cross-margin leverage applied to each symbol before entry
